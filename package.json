{
  "name": "@xmaxai/react-native-sdk",
  "version": "1.0.4",
  "description": "Xmax SDK for React Native",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "ios",
    "android/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "XmaxReactNativeSDK.podspec",
    "react-native.config.js"
  ],
  "workspaces": [
    "Example/XLab"
  ],
  "scripts": {
    "start": "npm run start --workspace @xmax/xlab --",
    "ios": "npm run ios --workspace @xmax/xlab --",
    "android": "npm run android --workspace @xmax/xlab --",
    "pods": "cd Example/XLab/ios && bundle exec pod install",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p Example/XLab/tsconfig.json",
    "lint": "eslint src Example/XLab/App.tsx Example/XLab/src Example/XLab/index.js && npm run lint:comments",
    "lint:comments": "node scripts/check-sdk-comments.mjs",
    "format:check": "node scripts/format-sdk.mjs --check && prettier --check scripts Example/XLab/App.tsx Example/XLab/src",
    "format:ios": "xcrun swift-format format --in-place --recursive ios",
    "format:ios:check": "xcrun swift-format lint --strict --recursive ios",
    "prepack": "npm run build",
    "test": "npm run build && tsc --noEmit -p tests/tsconfig.json && node --experimental-test-module-mocks --test tests/*.test.cjs",
    "format:sdk": "node scripts/format-sdk.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": ">=0.87.1 <0.88.0",
    "react-native-cos-sdk-nobeacon": "1.3.0",
    "react-native-blob-util": "0.24.10"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.2.18",
    "eslint": "9.39.1",
    "prettier": "2.8.8",
    "typescript": "6.0.3",
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "npm@11.16.0",
  "codegenConfig": {
    "name": "XmaxRuntimeSpec",
    "type": "modules",
    "jsSrcsDir": "src/Foundation/Native",
    "android": {
      "javaPackageName": "ai.xmax.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "XmaxRuntime": "XmaxRuntime"
      }
    }
  }
}
