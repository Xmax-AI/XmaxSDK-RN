source 'https://cdn.cocoapods.org/'
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'XLab' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Some dependency resource bundles retain older deployment targets. Raise
    # those targets to XLab's minimum without lowering any stricter requirement.
    minimum_ios = Gem::Version.new(min_ios_version_supported)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |configuration|
        deployment_target = configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next unless deployment_target&.match?(/\A\d+(\.\d+)*\z/)
        next unless Gem::Version.new(deployment_target) < minimum_ios

        configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios.to_s
      end
    end

    # A reinstall can retain Release frameworks while removing their flavor
    # markers. Let RN's own build scripts restore the requested configuration.
    %w[React-Core-prebuilt ReactNativeDependencies hermes-engine].each do |pod|
      directory = installer.sandbox.root.join(pod)
      File.write(directory.join('.last_build_configuration'), 'unknown') if directory.directory?
    end
  end
end
